{
  "//": "NEVER put a secret in this file. Secrets come from user secrets locally and Azure Key Vault in Azure.",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "NexaOpsDb": "Server=(localdb)\\MSSQLLocalDB;Database=NexaOps;Trusted_Connection=True;TrustServerCertificate=True",
    "Redis": ""
  },
  "Auth": {
    "Mode": "Local",
    "Issuer": "https://nexaops.local",
    "Audience": "nexaops-api",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinimumPasswordLength": 12,
    "EntraId": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "Audience": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Storage": {
    "BlobServiceUri": "",
    "ConnectionString": "",
    "LocalRootPath": "App_Data/storage",
    "MaxUploadBytes": 26214400
  },
  "Email": {
    "Endpoint": "",
    "ConnectionString": "",
    "FromAddress": "",
    "FromDisplayName": "NexaOps Service Desk",
    "RedirectAllTo": ""
  },
  "Messaging": {
    "FullyQualifiedNamespace": "",
    "ConnectionString": "",
    "TopicPrefix": "nexaops"
  },
  "AzureAi": {
    "Endpoint": "",
    "ChatDeployment": "",
    "EmbeddingDeployment": "",
    "UseManagedIdentity": true,
    "SearchEndpoint": "",
    "SearchIndexName": "nexaops-knowledge",
    "MaxToolIterations": 5
  },
  "Azure": {
    "KeyVaultUri": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Demo": {
    "SeedOnStartup": false
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "GeneralRequestsPerMinute": 300,
    "AuthenticationAttempts": 10,
    "AuthenticationWindowMinutes": 5,
    "AiRequestsPerMinute": 20
  }
}
