<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>NexaOps.Api</RootNamespace>
    <AssemblyName>NexaOps.Api</AssemblyName>
    <UserSecretsId>nexaops-api-9f2c4a71-0d3e-4b18-9d1a-6c5f0e2b7a44</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!--
      AV0029/AV0030 advise wiring the versioning library's own OpenAPI integration so that each
      API version gets a separate document. The API is at v1 only, and .NET 10's built-in OpenAPI
      produces the document we want. Revisit when v2 is introduced - at that point a document per
      version is genuinely needed and these should be removed rather than kept suppressed.
    -->
    <NoWarn>$(NoWarn);AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexaOps.Application\NexaOps.Application.csproj" />
    <ProjectReference Include="..\NexaOps.Infrastructure\NexaOps.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Web">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Label="Configuration and secrets">
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexaOps.Api.IntegrationTests" />
  </ItemGroup>

</Project>
