# Copy to .env.local and adjust. Never commit .env.local.
#
# The API base URL. In development Vite proxies /api to this, so the browser sees a
# same-origin request and no CORS round trip is needed.
VITE_API_BASE_URL=http://localhost:5266

# Shown in the top bar so it is obvious which environment is on screen during a demo.
# Leave empty for production.
VITE_ENVIRONMENT_LABEL=Development
